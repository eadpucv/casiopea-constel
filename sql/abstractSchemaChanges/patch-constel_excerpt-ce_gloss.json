				"type": "mwtimestamp",
				"options": {
					"notnull": true
				}
			},
			{
				"name": "ce_lost",
				"comment": "Momento en que el § se perdió; NULL mientras esté anclado.",
				"type": "mwtimestamp",
				"options": {
					"notnull": false
				}
			}
