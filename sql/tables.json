[
	{
		"name": "constel_concept",
		"comment": "Vocabulario GLOBAL de conceptos (spec: Concept). Identidad estricta como título MW.",
		"columns": [
			{
				"name": "cc_id",
				"comment": "Clave primaria.",
				"type": "integer",
				"options": {
					"unsigned": true,
					"notnull": true,
					"autoincrement": true
				}
			},
			{
				"name": "cc_key",
				"comment": "Forma canónica del rótulo (normalize_concept): es la identidad y el rótulo visible.",
				"type": "binary",
				"options": {
					"length": 320,
					"notnull": true
				}
			},
			{
				"name": "cc_fold",
				"comment": "Clave tolerante (sin tildes/mayúsculas, conserva ñ). SÓLO para sugerir variantes, nunca identifica.",
				"type": "binary",
				"options": {
					"length": 320,
					"notnull": true
				}
			},
			{
				"name": "cc_created",
				"comment": "Primera aportación.",
				"type": "mwtimestamp",
				"options": {
					"notnull": true
				}
			}
		],
		"indexes": [
			{
				"name": "cc_key",
				"columns": [
					"cc_key"
				],
				"unique": true
			},
			{
				"name": "cc_fold",
				"columns": [
					"cc_fold"
				],
				"unique": false
			}
		],
		"pk": [
			"cc_id"
		]
	},
	{
