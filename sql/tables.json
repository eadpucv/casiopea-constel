				"options": {
					"notnull": false,
					"length": 65530
				}
			},
			{
				"name": "ce_status",
				"comment": "anchor_status: 0 = anchored, 1 = lost.",
				"type": "mwtinyint",
				"options": {
					"unsigned": true,
					"notnull": true,
					"default": 0
				}
			},
			{
				"name": "ce_created",
				"comment": "Creación del §.",
				"type": "mwtimestamp",
				"options": {
					"notnull": true
				}
			},
			{
				"name": "ce_lost",
				"comment": "Momento en que el § se perdió; NULL mientras esté anclado.",
				"type": "mwtimestamp",
				"options": {
					"notnull": false
				}
			}
		],
