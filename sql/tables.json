				"options": {
					"unsigned": true,
					"notnull": true
				}
			},
			{
				"name": "ce_end",
				"comment": "TextAnchor.end (exclusivo), en code points.",
				"type": "integer",
				"options": {
					"unsigned": true,
					"notnull": true
				}
			},
			{
				"name": "ce_gloss",
				"comment": "Glosa del lector sobre el pasaje (comentario o aclaración). NULL = sin glosa.",
